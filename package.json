{
  "name": "local-tools",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:pdf": "pnpm --filter @local-tools/pdf dev",
    "preview:pdf": "pnpm --filter @local-tools/pdf preview",
    "dev:gif": "pnpm --filter @local-tools/gif dev",
    "preview:gif": "pnpm --filter @local-tools/gif preview",
    "dev:video": "pnpm --filter @local-tools/video dev",
    "preview:video": "pnpm --filter @local-tools/video preview",
    "dev:dev": "pnpm --filter @local-tools/dev dev",
    "preview:dev": "pnpm --filter @local-tools/dev preview",
    "dev:image": "pnpm --filter @local-tools/image dev",
    "preview:image": "pnpm --filter @local-tools/image preview",
    "dev:drop": "pnpm --filter @local-tools/drop dev",
    "preview:drop": "pnpm --filter @local-tools/drop preview",
    "dev:stack": "pnpm --filter @local-tools/stack dev",
    "preview:stack": "pnpm --filter @local-tools/stack preview",
    "dev:sheet": "pnpm --filter @local-tools/sheet dev",
    "preview:sheet": "pnpm --filter @local-tools/sheet preview",
    "dev:doc": "pnpm --filter @local-tools/doc dev",
    "preview:doc": "pnpm --filter @local-tools/doc preview",
    "dev:lab": "pnpm --filter @local-tools/lab dev",
    "preview:lab": "pnpm --filter @local-tools/lab preview",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "check": "node scripts/check-site-assets.mjs && pnpm -r check && vitest run"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "svelte": "^5.56.7",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
